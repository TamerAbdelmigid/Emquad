{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emquad",
  "version": "0.1.0",
  "identifier": "app.emquad.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emquad",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "sidecars/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "emquad"
        ],
        "name": "Emquad bundle",
        "description": "Emquad bundle",
        "role": "Editor"
      }
    ]
  }
}
